{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Streamlit: Run MaintAI Dashboard",
            "type": "debugpy",
            "request": "launch",
            "module": "streamlit",
            "args": [
                "run",
                "${workspaceFolder}/app.py"
            ],
            "jinja": true,
            "justMyCode": true,
            "console": "integratedTerminal"
        },
        {
            "name": "Python: Run Training Pipeline (train.py)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/train.py",
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "Python: Run EDA Script",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/notebooks/01_eda_and_model_prototyping.py",
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "Python: Run Pytest Tests",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": [
                "tests/test_pipeline.py",
                "-v"
            ],
            "console": "integratedTerminal"
        }
    ]
}
